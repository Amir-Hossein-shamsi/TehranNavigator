    "import osmnx as ox\n",
    "import networkx as nx\n",
    "from ipyleaflet import Map, Marker, Polyline\n",
    "# from geopy.geocoders import Nominatim\n",
    "from opencage.geocoder import OpenCageGeocode\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "4f4b34fe",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "49385762d57b4ce4a0f47a7d0adcea98",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "VBox(children=(HBox(children=(Text(value='', description='Origin:', layout=Layout(width='400px'), placeholder=…"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "CITY_NAME = \"Tehran, Iran\"\n",
    "NETWORK_TYPE = \"drive\"\n",
    "\n",
    "\n",
    "origin_widget = widgets.Text(\n",
    "    placeholder='Tehran University',\n",
    "    description='Origin:',\n",
    "    layout=widgets.Layout(width='400px')\n",
    ")\n",
    "\n",
    "destination_widget = widgets.Text(\n",
    "    placeholder='Azadi Tower',\n",
    "    description='Destination:',\n",
    "    layout=widgets.Layout(width='400px')\n",
    ")\n",
    "\n",
    "\n",
    "button = widgets.Button(description=\"Show Route\", button_style='success')\n",
    "status_label = widgets.Label(value='')\n",
    "output = widgets.Output()\n",
    "\n",
    "\n",
    "\n",
    "def geocode_address(address, geolocator):\n",
    "    \"\"\"Geocode an address with error handling.\"\"\"\n",
    "    try:\n",
    "        location = geolocator.geocode(f\"{address}\",language='fa')\n",
    "        if not location:\n",
    "            raise ValueError(f\"Address not found: {address}\")\n",
    "        return (location[0]['geometry']['lat'], location[0]['geometry']['lng'])\n",
    "    except Exception as e:\n",
    "        print(f\"Geocoding error: {e}\")\n",
    "        return None\n",
    "\n",
    "def compute_path(graph, origin_coords, dest_coords):\n",
    "    \"\"\"Compute fastest path between two coordinates.\"\"\"\n",
    "    try:\n",
    "        origin_node = ox.distance.nearest_nodes(graph, origin_coords[1], origin_coords[0])\n",
    "        dest_node = ox.distance.nearest_nodes(graph, dest_coords[1], dest_coords[0])\n",
    "        return nx.shortest_path(graph, origin_node, dest_node, weight='length')\n",
    "    except Exception as e:\n",
    "        print(f\"Pathfinding error: {e}\")\n",
    "        return []\n",
    "\n",
    "def extract_path_points(graph, path):\n",
    "    \"\"\"Extract full coordinates from path including geometries.\"\"\"\n",
    "    path_points = []\n",
    "    for u, v in zip(path[:-1], path[1:]):\n",
    "        data = graph.get_edge_data(u, v)\n",
    "        edge = data[0] if 0 in data else list(data.values())[0]\n",
    "\n",
    "        if 'geometry' in edge:\n",
    "            xs, ys = edge['geometry'].xy\n",
    "            segment = list(zip(ys, xs))  # (lat, lon)\n",
    "            if path_points and path_points[-1] == segment[0]:\n",
    "                segment = segment[1:]\n",
    "            path_points.extend(segment)\n",
    "        else:\n",
    "            lat1, lon1 = graph.nodes[u]['y'], graph.nodes[u]['x']\n",
    "            lat2, lon2 = graph.nodes[v]['y'], graph.nodes[v]['x']\n",
    "            if not path_points or path_points[-1] != (lat1, lon1):\n",
    "                path_points.append((lat1, lon1))\n",
    "            path_points.append((lat2, lon2))\n",
    "    return path_points\n",
    "\n",
    "def visualize_route(origin_coords, dest_coords, path_points):\n",
    "    \"\"\"Visualize route on an interactive map.\"\"\"\n",
    "    midpoint = [\n",
    "        (origin_coords[0] + dest_coords[0]) / 2,\n",
    "        (origin_coords[1] + dest_coords[1]) / 2\n",
    "    ]\n",
    "    m = Map(center=midpoint, zoom=12)\n",
    "    m.add_layer(Marker(location=origin_coords, draggable=False, title=\"Start\"))\n",
    "    m.add_layer(Marker(location=dest_coords, draggable=False, title=\"End\"))\n",
    "    m.add_layer(Polyline(locations=path_points, color=\"blue\", fill=False))\n",
    "    display(m)\n",
    "\n",
    "\n",
    "\n",
    "def on_button_clicked(b):\n",
    "    with output:\n",
    "        clear_output()\n",
    "        status_label.value = \"Geocoding addresses...\"\n",
    "        key = "SECRET_KEY_API"\n",
    "        geolocator = OpenCageGeocode(key)\n",
    "\n",
    "        origin = geocode_address(origin_widget.value, geolocator)\n",
    "        destination = geocode_address(destination_widget.value, geolocator)\n",
    "\n",
    "        if not origin or not destination:\n",
    "            status_label.value = \"Failed to geocode one or both addresses. Try refining input.\"\n",
    "            print(\"Failed to geocode one or both addresses.\")\n",
    "            return\n",
    "\n",
    "        status_label.value = \"Loading street network for Tehran...\"\n",
    "        try:\n",
    "            graph = ox.graph_from_place(CITY_NAME, network_type=NETWORK_TYPE)\n",
    "        except Exception as e:\n",
    "            status_label.value = \"Error loading map data.\"\n",
    "            print(f\"Error loading graph: {e}\")\n",
    "            return\n",
    "\n",
    "        status_label.value = \"Calculating route...\"\n",
    "        path = compute_path(graph, origin, destination)\n",
    "\n",
    "        if not path:\n",
    "            status_label.value = \"No route found between the locations.\"\n",
    "            print(\"No path found between the specified locations.\")\n",
    "            return\n",
    "\n",
    "        status_label.value = \"Building map...\"\n",
    "        path_points = extract_path_points(graph, path)\n",
    "        visualize_route(origin, destination, path_points)\n",
    "        status_label.value = \"✅ Route displayed!\"\n",
    "\n",
    "\n",
    "button.on_click(on_button_clicked)\n",
    "\n",
    "display(widgets.VBox([widgets.HBox([origin_widget, destination_widget]), button, status_label, output]))\n"
   ]
  }
 ],
